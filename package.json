{
  "name": "ai-concept-quiz",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "predev": "npm run build:content",
    "dev": "vite --mode development",
    "predev:phone": "npm run build:content",
    "dev:phone": "vite --mode development --host 0.0.0.0",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node scripts/eval-content.mjs",
    "eval:fingerprint": "node scripts/eval-content.mjs --fingerprint",
    "build:content": "node scripts/build-question-bank.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "audit:style": "node scripts/audit-content-style.mjs",
    "check:content": "npm run build:content && node scripts/check-content-structure.mjs",
    "prebuild:web": "npm run build:content",
    "build:web": "tsc -b && vite build --mode production",
    "prebuild:standalone": "npm run build:content",
    "build:standalone": "tsc -b && vite build --mode standalone",
    "build:ait": "ait build",
    "build:release": "npm run build:web && npm run build:standalone && npm run build:ait && npm run check:bundle",
    "build": "npm run build:release",
    "verify": "npm run check && npm run check:architecture && npm run typecheck && npm run test && npm run eval && npm run check:content && npm run build",
    "preview": "vite preview --mode production",
    "preview:standalone": "vite preview --mode standalone --host 0.0.0.0",
    "deploy": "ait deploy"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.0.3",
    "@sentry/react": "10.70.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "3.0.3",
    "@biomejs/biome": "2.5.8",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
