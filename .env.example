# local | standalone | prd
VITE_APP_PROFILE=local

# static is the only implemented source in the MVP.
# A future backend adapter can add api without changing feature components.
VITE_CONTENT_SOURCE=static

# Keep false until an approved ad provider and Apps in Toss ad group are configured.
VITE_ADS_ENABLED=false

# Optional JavaScript error monitoring. Leave blank to avoid loading or contacting Sentry.
# Use a client DSN only. Never put SENTRY_AUTH_TOKEN in VITE_* variables.
VITE_SENTRY_DSN=
